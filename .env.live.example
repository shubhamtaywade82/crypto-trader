# =============================================================================
# Crypto Trader v4  —  Live Trading Configuration Template (Low Capital Setup)
# =============================================================================
#
# USAGE
#   1. Copy this template to create your live configuration:
#      cp .env.live.example .env.live
#   2. Fill in your real API credentials and acknowledgment inside:
#      .env.secrets (which takes priority and is gitignored)
#
# DESIGN INTENT
#   This profile is optimized for low-capital E2E live validation:
#   • Runs on real CoinDCX Futures (Mainnet) but utilizes Binance WebSocket for data
#   • Targets highly liquid, tight-spread symbols (SOL, BTC, ETH) to minimize slippage
#   • Enforces strict risk metrics (3x leverage, 0.5% risk-per-trade, daily loss halt)
#   • Uses round-robin multi-key/multi-host LLM failovers to prevent rate-limit blocks
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 1 — TRADING MODE & TRIPLE SECURITY GATES
# ─────────────────────────────────────────────────────────────────────────────
# Set to 'live' to route real orders to CoinDCX
MODE=live

# TRIPLE SAFETY GATE:
# ⚠️ All three must be set correctly. Place the ACK in .env.secrets for security.
LIVE_TRADING_ENABLED=true
PLACE_ORDER=true

# Note: In your `.env.secrets` you MUST configure:
# LIVE_TRADING_ACK=I_UNDERSTAND_REAL_MONEY_WILL_BE_LOST

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 2 — SYMBOLS & UNIVERSE
# ─────────────────────────────────────────────────────────────────────────────
# Primary symbol for single-symbol operations
TRADE_SYMBOL=SOLUSDT

# Watchlist for the multi-symbol engine (keeps watchlist tight for low-capital testing)
WATCHLIST=SOLUSDT,BTCUSDT,ETHUSDT

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 3 — RISK & CAPITAL MANAGEMENT
# ─────────────────────────────────────────────────────────────────────────────
# Position-sizing reference (set to match your real futures balance, e.g., 50 or 100 USDT)
INITIAL_BALANCE=50

# Leverage. MAX_LEVERAGE is the hard ceiling (system caps at 20x; per-symbol
# further clamped to the venue instrument cap). Start conservative on live.
LEVERAGE=3
MAX_LEVERAGE=5

# ── Dynamic per-trade leverage (optional) ──
# true → each entry's leverage is chosen inside [MIN, MAX]: starts at the FLOOR,
# climbs toward the ceiling only when conditions align (low vol, strong trend,
# healthy account); risk factors pull it to the floor; extreme vol / dead-market
# halts. MAX_LEVERAGE is the ceiling (only in ideal conditions), not the default.
# Keep OFF until validated in paper. To use the full 5-20x band set MAX_LEVERAGE=20.
USE_DYNAMIC_LEVERAGE=false
DYNAMIC_LEVERAGE_MIN=5
DYNAMIC_LEVERAGE_MAX=20
# Scaling sensitivity (defaults shown). ATR% fraction-of-price; dd/margin 0-1.
# DYNAMIC_LEVERAGE_HIGH_VOL_THRESHOLD=0.05
# DYNAMIC_LEVERAGE_EXTREME_VOL_THRESHOLD=0.10
# DYNAMIC_LEVERAGE_DRAWDOWN_MODERATE=0.05
# DYNAMIC_LEVERAGE_DRAWDOWN_SEVERE=0.10
# DYNAMIC_LEVERAGE_MARGIN_MODERATE=0.25
# DYNAMIC_LEVERAGE_MARGIN_HIGH=0.50
# DYNAMIC_LEVERAGE_VOL_ATR_PERIOD=14
# DYNAMIC_LEVERAGE_REGIME_BOOST=true

# Risk budget per trade (0.5% of equity)
RISK_PER_TRADE_PCT=0.005

# Hard Risk Rules (Config-driven limits):
# Max daily realized drawdown before halting the bot (3%)
DAILY_MAX_LOSS_PCT=0.03

# Lockdown threshold: max consecutive losses before lockout (3 losses)
MAX_CONSECUTIVE_LOSSES=3

# Cooldown duration after lockdown / consecutive loss lockout (1440 mins = 24 hours)
LOSS_COOLDOWN_MINUTES=1440

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 4 — STRATEGY & LIFECYCLE
# ─────────────────────────────────────────────────────────────────────────────
STRATEGY_MODE=mean_reversion

# Mean-Reversion execution parameters
MR_TIMEFRAME=15m
MR_SMA_PERIOD=20
MR_ENTRY_BAND=0.015
MR_STOP_LOSS_PCT=0.008

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 5 — DATA SOURCE & DECOUPLED EXECUTION
# ─────────────────────────────────────────────────────────────────────────────
# Use Binance for fast WS market data feeds, CoinDCX for order fulfillment
DATA_SOURCE=binance
FEED_STALE_MS=15000

# Opt-in to decoupled Redis execution (recommended for live production reliability)
EXECUTION_BUS=redis
REDIS_URL=redis://localhost:6382/0
DATABASE_URL=postgresql://trader:trader@localhost:5435/crypto_trader
PROJECTION_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 6 — HARDENED LLM ADVISORY (API KEY & HOST ROTATION)
# ─────────────────────────────────────────────────────────────────────────────
USE_CLOUD_LLM=true

# ── 6a. Cloud LLM Config (Comma-separated keys for proactive rotation + failover) ──
CLOUD_OLLAMA_HOST=https://api.ollama.com
CLOUD_OLLAMA_MODEL=qwen3.5:cloud
# CLOUD_OLLAMA_API_KEY=key_1,key_2,key_3  <-- PLACE IN .env.secrets

# ── 6b. Local LLM Config (Comma-separated backup host list for local failover) ──
OLLAMA_HOST=http://localhost:11434,http://192.168.1.50:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_PREDICT=1536
OLLAMA_TIMEOUT=30
