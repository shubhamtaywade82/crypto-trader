# =========================================================================
# Crypto Trader v4 Configuration Template
# =========================================================================

# -------------------------------------------------------------------------
# 1. REQUIRED CONFIGURATION (Secrets, Webhooks & Safety Gates)
# -------------------------------------------------------------------------

# ── CoinDCX Live Trading Credentials ──
# Set to true to route live order placement and cancellation requests to CoinDCX
LIVE_TRADING_ENABLED=false

# Must match exactly "I_UNDERSTAND_REAL_MONEY_WILL_BE_LOST" to allow live trading execution
LIVE_TRADING_ACK=

# Private API credentials (obtain from CoinDCX Settings -> API Management)
COINDCX_API_KEY=your_coindcx_api_key_here
COINDCX_API_SECRET=your_coindcx_api_secret_here

# ── Telegram Notification & Remote Control ──
# Get your token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get your ID from @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here


# -------------------------------------------------------------------------
# 2. OPTIONAL CONFIGURATION (LLM, Risk & System Defaults)
# Note: You can delete these from your .env entirely; the code will fallback
#       to the default values shown below automatically.
# -------------------------------------------------------------------------

# ── Ollama LLM Settings (Local) ──
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_API_KEY=

# ── Ollama LLM Settings (Cloud) ──
# CLOUD_OLLAMA_HOST=https://ollama.com
# CLOUD_OLLAMA_MODEL=deepseek-v3:cloud
# CLOUD_OLLAMA_API_KEY=

# ── Mode Toggle ──
# USE_CLOUD_LLM=false
# USE_OPENAI_FORMAT=false

# ── LLM Latency & Timeout Settings ──
# OLLAMA_TIMEOUT=300
# OLLAMA_MAX_TOKENS=512
# LLM_CACHE_TTL=1800
# LLM_MAX_AGE=120
# LLM_MAX_LATENCY=60000

# ── LLM Fusion & Gating Settings ──
# LLM_WEIGHT=0.20
# FINAL_SCORE_THRESHOLD=0.75

# ── Granular Logging Settings ──
# LOG_BINANCE_RESPONSES=false
# LOG_LLM=false

# ── CoinDCX Custom API URL (Default: https://api.coindcx.com) ──
# COINDCX_API_URL=https://api.coindcx.com
