# =============================================================================
# Crypto Trader v4  —  Configuration Template (Paper Mode, Full Workflow)
# =============================================================================
#
# USAGE
#   cp .env.example .env
#   # Then copy secrets template and fill in your real keys:
#   cp .env.secrets.example .env.secrets
#
# This file is the NON-SENSITIVE configuration template. It defaults to a
# fully-enabled paper-trading workflow with:
#   ✅  Aggressive signal profile (max signals, relaxed filters)
#   ✅  Mean-reversion strategy (highest signal frequency)
#   ✅  LLM advisory layer enabled (local Ollama)
#   ✅  Multi-threaded WebSocket engine + thread supervisor
#   ✅  Redis Streams execution bus (decoupled producer/consumer)
#   ✅  Postgres persistence + read-model projections
#   ✅  Dashboard API + realtime SSE events
#   ✅  Telegram notifications (token → .env.secrets)
#   ✅  All safety guards active (G1–G9, F1–F5)
#   🔒  Live trading BLOCKED — override in .env.secrets when ready
#
# LOADING ORDER (highest priority first)
#   1. .env.secrets  — API keys, tokens, live-trading gates (always overrides)
#   2. .env          — this file (non-sensitive config, no-override)
#   3. OS environment variables (win over .env, lose to .env.secrets)
#
# SECRETS: All API keys, passwords, and tokens live in .env.secrets
#          (gitignored). This file intentionally contains NO secrets.
# =============================================================================



# ─────────────────────────────────────────────────────────────────────────────
# SECTION 1 — TRADING MODE & SAFETY GATES
# ─────────────────────────────────────────────────────────────────────────────
# paper  = simulated fills against live Binance market data, no orders sent
# live   = real CoinDCX mainnet orders — requires all gates below + .env.secrets

MODE=paper

# ── Live-trading triple gate (all three required; override in .env.secrets) ──
# Gate 1: must be explicitly enabled
LIVE_TRADING_ENABLED=false
# Gate 2: explicit acknowledgement phrase (case-sensitive)
LIVE_TRADING_ACK=
# Gate 3: read-only switch — set false to observe live feed without sending orders
PLACE_ORDER=false



# ─────────────────────────────────────────────────────────────────────────────
# SECTION 2 — TRADING UNIVERSE & SYMBOLS
# ─────────────────────────────────────────────────────────────────────────────
# Primary symbol for single-symbol engines (Binance-style ticker).
# Mapped internally to CoinDCX format: B-<BASE>_USDT
TRADE_SYMBOL=SOLUSDT

# Watchlist for the multi-symbol engine (multi_engine, mean-reversion, etc.)
# Comma-separated, Binance-style. More symbols = more signal opportunities.
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT



# ─────────────────────────────────────────────────────────────────────────────
# SECTION 3 — CAPITAL & LEVERAGE
# ─────────────────────────────────────────────────────────────────────────────
# Starting equity (paper wallet) / position-sizing reference (live wallet).
INITIAL_BALANCE=1000

# Active leverage for position sizing and margin calculations.
# MAX_LEVERAGE is the hard ceiling (LeverageEngine caps at 20x; per-symbol it is
# further clamped to the venue instrument cap). Conservative paper default below.
LEVERAGE=5
MAX_LEVERAGE=20

# ── Dynamic per-trade leverage (optional) ──
# When true, each entry's leverage is chosen inside [MIN, MAX]: it starts at the
# FLOOR and climbs toward the ceiling only when conditions align — low
# volatility, strong trending regime, healthy account. Risk factors pull it back
# to the floor; extreme vol / dead-market halts the trade. MAX_LEVERAGE is the
# ceiling (only in ideal conditions), NOT the default (calm markets ~9-12x).
# Default OFF — the bot uses the fixed MAX_LEVERAGE. Enable after paper testing.
USE_DYNAMIC_LEVERAGE=false
DYNAMIC_LEVERAGE_MIN=5
DYNAMIC_LEVERAGE_MAX=20
# Scaling sensitivity (when leverage is pulled toward the floor). Defaults shown.
# ATR% is fraction-of-price; drawdown / margin are fractions (0-1).
# DYNAMIC_LEVERAGE_HIGH_VOL_THRESHOLD=0.05      # above this, vol starts cutting
# DYNAMIC_LEVERAGE_EXTREME_VOL_THRESHOLD=0.10   # above this, halt (0x)
# DYNAMIC_LEVERAGE_DRAWDOWN_MODERATE=0.05       # full headroom below this
# DYNAMIC_LEVERAGE_DRAWDOWN_SEVERE=0.10         # floor at/above this
# DYNAMIC_LEVERAGE_MARGIN_MODERATE=0.25
# DYNAMIC_LEVERAGE_MARGIN_HIGH=0.50
# DYNAMIC_LEVERAGE_VOL_ATR_PERIOD=14
# DYNAMIC_LEVERAGE_REGIME_BOOST=true            # trend regimes lever up, chop/dead down



# ─────────────────────────────────────────────────────────────────────────────
# SECTION 4 — STRATEGY ENGINE
# ─────────────────────────────────────────────────────────────────────────────
# Which entry/exit engine is active:
#   legacy          — original multi-playbook system (A, B, Ares, VolX, Sweep)
#   supertrend2     — Supertrend2 adaptive-ATR trend-following
#   mean_reversion  — SMA-band mean-reversion  ← generates the MOST signals
#   smc             — Production SMC 10-stage pipeline (structure + OI/vol/RVOL/
#                     liquidation fused into a weighted 0-100 confidence score;
#                     only trades clearing SMC_MIN_SCORE with all gates passing).
#                     EDGE UNPROVEN — backtest before allocating capital.
STRATEGY_MODE=supertrend2

# ── 4a. Mean-Reversion Settings (STRATEGY_MODE=mean_reversion) ───────────────
# Kline timeframe for signal candles (shorter = more signals).
# Valid: 1m 3m 5m 15m 30m 1h 2h 4h 6h 8h 12h 1d
MR_TIMEFRAME=15m

# SMA period — shorter periods react faster and fire more entries.
MR_SMA_PERIOD=20

# Entry band: price must deviate this far from SMA to open a position.
# Smaller band = more entries. 0.015 = 1.5% deviation (PRD default).
MR_ENTRY_BAND=0.015

# Hard stop-loss from fill price. 0.008 = 0.8%.
MR_STOP_LOSS_PCT=0.008

# ── 4b. Supertrend2 Settings (STRATEGY_MODE=supertrend2) ─────────────────────
# Uncomment to use Supertrend2 instead of mean-reversion.
# ST2_ATR_PERIOD=10
# ST2_FACTOR=3.0
# ST2_USE_ADAPTIVE_ATR=true
# ST2_TIMEFRAME=1h
# ST2_HTF_TIMEFRAME=4h
# ST2_ENTRY_MODE=flip              # flip | retracement
# ST2_RETRACEMENT_PCT=1.0
# ST2_FLIP_LOOKBACK=5
# ST2_USE_HTF_FILTER=true          # false = more signals (less filtering)
# ST2_USE_VOL_FILTER=false
# ST2_VOL_MULTIPLIER=1.2
# ST2_USE_ADX_FILTER=false
# ST2_ADX_THRESHOLD=20
# ST2_TP1_PCT=1.0
# ST2_USE_TP=true
# ST2_SL_MODE=supertrend           # supertrend | fixed_pct | atr
# ST2_SL_PCT=1.5
# ST2_SL_ATR_MULT=2.5
# ST2_MAX_HOLD_HOURS=168           # max hold: 7 days

# ── 4d. SMC Pipeline Settings (STRATEGY_MODE=smc) ────────────────────────────
# 9-factor weighted score (HTF 15, sweep 15, structure 15, OB 12, FVG 10,
# OI 12, vol 10, RVOL 8, liq 3). Hard gates: HTF-align + in-direction fresh
# sweep + in-direction fresh BOS/CHoCH + no active liquidation cascade + score
# ≥ SMC_MIN_SCORE. NOTE: OI delta is not yet tracked engine-side, so the OI
# factor is dropped and the remaining weights renormalised (not scored 0).
# SMC_ENTRY_TIMEFRAME=15m          # entry/setup timeframe
# SMC_HTF_TIMEFRAME=4h             # higher-timeframe bias
# SMC_SWING_WINDOW=3               # swing-pivot radius
# SMC_MIN_SCORE=70                 # composite score gate (guide: ≥70)
# SMC_SWEEP_LOOKBACK=12            # max candles since the liquidity sweep
# SMC_STRUCTURE_LOOKBACK=12        # max candles since BOS/CHoCH
# SMC_OI_EXPANSION_PCT=3.0         # OI %Δ for full OI factor (when available)
# SMC_VOLUME_MULT_TARGET=3.0       # displacement vol / 20-avg for full vol factor
# SMC_RVOL_TARGET=1.2              # RVOL for full RVOL factor
# SMC_LIQ_CASCADE_THRESHOLD=0.5    # liquidation intensity ≥ ⇒ reject (cascade)
# SMC_ATR_PERIOD=14
# SMC_SL_BUFFER_ATR=0.5            # ATR padding beyond the sweep wick
# SMC_SL_ATR_MULT=1.5              # ATR cap on stop distance (keeps RR sane)
# SMC_TP_RR=2.0                    # TP risk-reward ceiling / fallback
# SMC_MAX_HOLD_HOURS=24            # safety time-stop

# ── 4c. Entry Order Style ─────────────────────────────────────────────────────
# market       — immediate market fill (default, fastest execution)
# maker_limit  — passive limit first, market fallback (reduces slippage in live)
ENTRY_ORDER_STYLE=market
# MAKER_LIMIT_TIMEOUT_S=8.0
# MAKER_LIMIT_OFFSET_BPS=1.0
# MAKER_LIMIT_FALLBACK=market



# ─────────────────────────────────────────────────────────────────────────────
# SECTION 5 — TRADING PROFILE (Signal Quality vs. Frequency)
# ─────────────────────────────────────────────────────────────────────────────
# conservative  — tight filters, max 2 trades/day, 2x leverage cap
# moderate      — balanced, max 5 trades/day, 3x leverage cap
# aggressive    — relaxed filters, max 10 trades/day, 5x leverage cap ← RECOMMENDED for paper
TRADING_PROFILE=aggressive

# ── Profile overrides (leave blank to use profile defaults) ──────────────────
# Score thresholds: lower = more signals pass through the quality gate.
# Profile defaults: conservative=0.82, moderate=0.72, aggressive=0.62
FINAL_SCORE_THRESHOLD=0.55

# Adaptive threshold floor — how low the threshold can decay when the bot is idle.
# Profile defaults: conservative=0.75, moderate=0.60, aggressive=0.45
ADAPTIVE_MIN_THRESHOLD=0.40

# Target trades per day — controls how fast idle threshold decays.
# Profile defaults: conservative=1.0, moderate=2.0, aggressive=3.0
ADAPTIVE_TARGET_TRADES_PER_DAY=4.0

# Decay per idle hour — how much the threshold drops toward the floor.
# Profile defaults: conservative=0.005, moderate=0.01, aggressive=0.02
ADAPTIVE_DECAY_PER_HOUR=0.025

# Risk per trade as a fraction of equity. 0.04 = 4%.
# Profile defaults: conservative=0.01, moderate=0.02, aggressive=0.04
# Spec default (no profile): 0.005 (0.5% of equity)
RISK_PER_TRADE_PCT=0.04

# Max drawdown before the engine halts. 0.25 = 25%.
MAX_DRAWDOWN_PCT=0.25

# Consecutive losing trades before circuit-breaker trips.
MAX_CONSECUTIVE_LOSSES=4

# ── Hard risk limits (spec defaults — override only if you understand the risk) ──
# Maximum daily loss as a fraction of initial daily balance before trading halts.
# Spec default: 0.03 (3%). Env var: DAILY_MAX_LOSS_PCT
DAILY_MAX_LOSS_PCT=0.03

# Cooldown duration (in minutes) after recording a loss before new entries are allowed.
# Spec default: 1440 (24 hours). Env var: LOSS_COOLDOWN_MINUTES
LOSS_COOLDOWN_MINUTES=1440

# Daily trade cap — overrides profile default.
MAX_DAILY_TRADES=20

# LLM advisory fusion weight (0.0–1.0). Higher = LLM has more influence.
LLM_WEIGHT=0.20



# ─────────────────────────────────────────────────────────────────────────────
# SECTION 6 — RISK & PRODUCTION SAFETY GUARDS (G1–G9)
# ─────────────────────────────────────────────────────────────────────────────
# G1 — Max local↔venue clock drift (ms) before warning.
CLOCK_SKEW_MAX_MS=2000

# G2 — Per-minute order velocity circuit breaker (orders/minute/symbol).
MAX_ORDERS_PER_MINUTE=6

# G3 — Kill the engine if a WebSocket feed / position-manager thread dies silently.
THREAD_SUPERVISOR_ENABLED=true

# G4 — Halt + flatten all positions when exchange margin ratio exceeds this.
MAX_MARGIN_RATIO=0.80

# G5 — On unresolved venue desync: cancel ALL venue orders before halting.
RECONCILE_STRICT_CANCEL=false

# ── Market regime / session filter ──
# Restrict entries to London/NY institutional kill zones (true = stricter, fewer signals).
REQUIRE_KILL_ZONE=false

# Relative-volume thresholds for regime classification.
RVOL_DEAD_THRESHOLD=0.6      # below → DEAD_MARKET, no entries
RVOL_WEAK_THRESHOLD=0.9      # below → LOW_VOL_CHOP, half size
RVOL_STRONG_THRESHOLD=1.5    # above → full / boosted size

# Position-size multipliers from regime.
REGIME_SIZE_MULTIPLIER_HIGH=1.25   # TREND_EXPANSION boost
REGIME_SIZE_MULTIPLIER_LOW=0.5     # LOW_VOL_CHOP / MEAN_REVERSION reduction

# Funding-rate extreme guard: skip entries above this funding rate.
FUNDING_EXTREME_THRESHOLD=0.001



# ─────────────────────────────────────────────────────────────────────────────
# SECTION 7 — BINANCE MARKET DATA
# ─────────────────────────────────────────────────────────────────────────────
# Data source for klines, mark price, and funding rate signals.
# auto     — Binance primary, CoinDCX fallback (recommended)
# binance  — Binance only (best quality, may geo-block)
# coindcx  — CoinDCX only (lower quality, always reachable)
DATA_SOURCE=auto

# Feed freshness budget (ms). Entries/exits are vetoed when ALL sources are stale.
FEED_STALE_MS=15000

# Log raw Binance HTTP responses to the console (very verbose, debug only).
LOG_BINANCE_RESPONSES=false



# ─────────────────────────────────────────────────────────────────────────────
# SECTION 8 — COINDCX EXCHANGE CONNECTION
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  API credentials (COINDCX_API_KEY, COINDCX_API_SECRET) → .env.secrets

# REST API base URL (change only if CoinDCX moves its endpoint).
COINDCX_BASE_URL=https://api.coindcx.com

# Futures margin currency: USDT or INR (must match your funded futures wallet).
COINDCX_MARGIN_CURRENCY=USDT

# ── Venue-resident protective stops (F1) ──────────────────────────────────────
# Place a resting STOP_MARKET on CoinDCX after entry — protects against crashes.
COINDCX_VENUE_SL_ENABLED=true
# Place a resting TAKE_PROFIT_MARKET (software TP/scale-outs exist, usually off).
COINDCX_VENUE_TP_ENABLED=false
# Treat SL placement failure as a HALT condition (true = stricter, safer).
COINDCX_REQUIRE_VENUE_SL=false
# Software-backup SL only fires this many bps past the venue SL (defence-in-depth).
SOFTWARE_SL_BACKUP_BPS=15

# ── TDS accounting for Indian residents (F2) ──────────────────────────────────
# 1% TDS deducted on the sell leg. Auto-enabled when MARGIN_CURRENCY=INR.
COINDCX_TDS_ENABLED=
COINDCX_TDS_RATE=0.01

# ── Private / user stream via socket.io (F5) ──────────────────────────────────
# Real-time fill and position events; augments (never replaces) REST polling.
COINDCX_USER_STREAM_ENABLED=true
COINDCX_STREAM_URL=wss://stream.coindcx.com
COINDCX_STREAM_CHANNEL=coindcx

# ── Cross-venue basis guard (F3) ──────────────────────────────────────────────
# Signals fire on Binance price but fills land on CoinDCX. Guard the spread gap.
# Reject entry when |(coindcx_mark − binance_mark) / binance_mark| > max.
BASIS_GUARD_ENABLED=true
MAX_CROSS_VENUE_BASIS=0.005
ENTRY_BASIS_BUFFER=0.0005

# ── Paper execution-degradation model (F4) ────────────────────────────────────
# Simulate realistic CoinDCX liquidity conditions in paper mode.
PAPER_CDCX_SPREAD_COEFF=0.0015    # per-side spread penalty applied at fill
PAPER_COLLAR_PCT=0.10              # reject paper fills that deviate > 10% from ref



# ─────────────────────────────────────────────────────────────────────────────
# SECTION 9 — DELTA-NEUTRAL FUNDING-RATE ARBITRAGE (Strategy C, optional)
# ─────────────────────────────────────────────────────────────────────────────
# Non-directional spot + perp carry trade. Off by default.
# Enable only when spot execution and sufficient capital are available.
FUNDING_ARB_ENABLED=false
# FUNDING_ARB_NOTIONAL_USDT=0.0    # notional per arb leg (0 = no entries)
# FUNDING_ARB_QTY_STEP=0.0001
# MIN_FUNDING_TO_ENTER=0.0001      # skip entry if funding rate < this
# FUNDING_EXIT_FLOOR=0.0           # unwind when carry flips negative
# MIN_FUNDING_TO_HOLD=0.00003      # unwind when carry < round-trip cost
# MAX_ENTRY_BASIS=0.005
# MAX_BASIS_DRIFT=0.006
# FUNDING_INTERVAL_MS=28800000     # 8-hour CoinDCX funding interval



# ─────────────────────────────────────────────────────────────────────────────
# SECTION 10 — PERSISTENCE: POSTGRES + REDIS STREAMS
# ─────────────────────────────────────────────────────────────────────────────
# ── Postgres event journal ────────────────────────────────────────────────────
# Production JSONB event store. Leave blank → SQLite dev fallback.
# Override with production credentials in .env.secrets.
DATABASE_URL=postgresql://trader:trader@localhost:5435/crypto_trader

# Materialise relational read-model tables (active_positions/orders/fills)
# derived from the JSONB event stream. Required for dashboard queries.
PROJECTION_ENABLED=true

# ── Redis Streams execution bus ───────────────────────────────────────────────
# Decouples the strategy (producer) from execution (consumer group).
# EXECUTION_BUS=redis enables the in-process consumer thread.
# inproc = single-process synchronous path (simpler, no Redis dependency)
# redis  = fully decoupled async path with DLQ + PEL crash recovery
EXECUTION_BUS=redis
REDIS_URL=redis://localhost:6382/0

# Stream / consumer group names (change only if running multiple bots).
SIGNAL_STREAM=execution:signals
CONSUMER_GROUP=execution_engine

# Poison-pill: send to DLQ after this many failed delivery attempts.
SIGNAL_MAX_DELIVERIES=3

# Idempotency window (seconds) — suppresses duplicate/replayed signals.
IDEMPOTENCY_TTL_SECONDS=300



# ─────────────────────────────────────────────────────────────────────────────
# SECTION 11 — DASHBOARD API & REALTIME UI
# ─────────────────────────────────────────────────────────────────────────────
# FastAPI + SSE bridge. Start with:
#   uvicorn crypto_trader.api.app:app --host 0.0.0.0 --port 8000
API_HOST=0.0.0.0
API_PORT=8000

# ⚠️  Optional bearer-token auth for the dashboard (set in .env.secrets).
# API_DASHBOARD_TOKEN=

# CORS allowed origins (comma-separated, * = all — fine for local dev).
ALLOWED_ORIGINS=*

# Bot publishes domain events to Redis pub/sub; dashboard relays via SSE.
UI_EVENTS_ENABLED=true
UI_EVENTS_CHANNEL=events:ui



# ─────────────────────────────────────────────────────────────────────────────
# SECTION 12 — TELEGRAM NOTIFICATIONS & REMOTE CONTROL
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID → .env.secrets
#
# How to set up:
#   1. Message @BotFather on Telegram → /newbot → copy the token
#   2. Message your bot, then visit:
#      https://api.telegram.org/bot<TOKEN>/getUpdates  → find chat_id
#   3. Add both to .env.secrets (never commit real values here)



# ─────────────────────────────────────────────────────────────────────────────
# SECTION 13 — LLM ADVISORY LAYER (Ollama — Local)
# ─────────────────────────────────────────────────────────────────────────────
# The LLM scores each signal (0–1) and is fused with the quant score via LLM_WEIGHT.
# It is advisory-only — the quant safety gates are never bypassed.

# Master toggle: true = LLM advisory active, false = quant-only mode.
USE_LLM=true

# ── Local Ollama endpoint ─────────────────────────────────────────────────────
# OLLAMA_BASE_URL and OLLAMA_HOST are both accepted (BASE_URL takes precedence).
OLLAMA_BASE_URL=http://localhost:11434

# Model to use. Must be pulled locally: `ollama pull <model>`
# Recommended fast models: qwen3.5:4b  llama3.1:8b  mistral:7b
OLLAMA_MODEL=qwen3.5:4b

# ⚠️  OLLAMA_API_KEY → .env.secrets (blank = no auth, typical for local Ollama)

# ── Request tuning ────────────────────────────────────────────────────────────
# Max time to wait for a single LLM response (seconds). Paper mode can afford more.
OLLAMA_TIMEOUT=120

# Max tokens to generate per response (legacy advisor client; keep low for speed).
OLLAMA_MAX_TOKENS=256

# Max tokens for the AI-subsystem router's local provider. Must be large enough
# to fit the full JSON decision — too low truncates output mid-string and trips
# the LLM circuit breaker with JSONDecodeError. 1536 leaves comfortable headroom.
OLLAMA_NUM_PREDICT=1536

# Stale cache TTL (seconds). LLM advice older than this is re-requested.
LLM_CACHE_TTL=900

# Max age of a cached LLM score before it is treated as expired for a signal.
LLM_MAX_AGE=120

# Max latency (ms) before the LLM call is skipped and quant-only mode activates.
LLM_MAX_LATENCY=30000

# Use OpenAI-compatible /v1/chat/completions format instead of Ollama native.
USE_OPENAI_FORMAT=false



# ─────────────────────────────────────────────────────────────────────────────
# SECTION 14 — LLM ADVISORY LAYER (Ollama — Cloud / Remote)
# ─────────────────────────────────────────────────────────────────────────────
# Set USE_CLOUD_LLM=true to route requests to the cloud endpoint below.
# ⚠️  CLOUD_OLLAMA_API_KEY → .env.secrets
USE_CLOUD_LLM=false
CLOUD_OLLAMA_HOST=https://api.ollama.com
CLOUD_OLLAMA_MODEL=qwen3.5:cloud



# ─────────────────────────────────────────────────────────────────────────────
# SECTION 15 — LOGGING & OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────────
# Log LLM prompt payloads and truncated JSON responses (debug only).
LOG_LLM=false

# Log raw Binance REST responses (very verbose — debug only).
LOG_BINANCE_RESPONSES=false

# Terminal colour control (respects NO_COLOR spec: https://no-color.org).
# NO_COLOR=false
# FORCE_COLOR=false
