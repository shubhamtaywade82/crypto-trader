# =========================================================================
# Crypto Trader v4 Configuration Template
# =========================================================================

# ── Ollama LLM Settings (Local) ──
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_API_KEY=

# ── Ollama LLM Settings (Cloud) ──
CLOUD_OLLAMA_HOST=https://ollama.com
CLOUD_OLLAMA_MODEL=deepseek-v3:cloud
CLOUD_OLLAMA_API_KEY=

# ── Mode Toggle ──
# Set to true to use CLOUD_ settings, false to use OLLAMA_ (local) settings
USE_CLOUD_LLM=false

# Set to true only if using a non-Ollama OpenAI-compatible provider (e.g. Groq)
USE_OPENAI_FORMAT=false

# Maximum API request timeout in seconds (useful for LLM cold starts)
OLLAMA_TIMEOUT=320

# Max tokens generated by the LLM response
OLLAMA_MAX_TOKENS=512

# ── LLM Fusion & Budgeting Settings ──
# Cache TTL in seconds for LLM predictions to save tokens/latency
LLM_CACHE_TTL=1800

# Maximum age of cached LLM advice in seconds before rejecting it as stale
LLM_MAX_AGE=120

# Latency budget in milliseconds. If LLM exceeds this, technical trade proceeds
LLM_MAX_LATENCY=60000

# Weight (influence) of the LLM advisor on the final confidence score (0.0 to 1.0)
LLM_WEIGHT=0.20

# Final combined confidence score threshold required to trigger trades (0.0 to 1.0)
FINAL_SCORE_THRESHOLD=0.75

# ── Granular Logging Settings ──
# Master response logger toggle (set to true/1/yes to log all REST/WS/LLM JSON)
LOG_BINANCE_RESPONSES=false

# Log all prompt payloads sent to Ollama and truncated JSON responses (true/false)
LOG_LLM=false

# ── Telegram Notification & Remote Control ──
# Get your token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get your ID from @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here
