# =========================================================================
# Crypto Trader v4 Configuration Template
# =========================================================================

# -------------------------------------------------------------------------
# 1. REQUIRED CONFIGURATION (Secrets, Webhooks & Safety Gates)
# -------------------------------------------------------------------------

# ── CoinDCX Live Trading Credentials ──
# Set to true to route live order placement and cancellation requests to CoinDCX
LIVE_TRADING_ENABLED=false

# Must match exactly "I_UNDERSTAND_REAL_MONEY_WILL_BE_LOST" to allow live trading execution
LIVE_TRADING_ACK=I_UNDERSTAND_REAL_MONEY_WILL_BE_LOST

# Private API credentials (obtain from CoinDCX Settings -> API Management)
COINDCX_API_KEY=your_coindcx_api_key_here
COINDCX_API_SECRET=your_coindcx_api_secret_here

# ── Telegram Notification & Remote Control ──
# Get your token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get your ID from @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here


# -------------------------------------------------------------------------
# 2. OPTIONAL CONFIGURATION (LLM, Risk & System Defaults)
# Note: You can delete these from your .env entirely; the code will fallback
#       to the default values shown below automatically.
# -------------------------------------------------------------------------

# ── Ollama LLM Settings (Local) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_API_KEY=

# ── Ollama LLM Settings (Cloud) ──
# CLOUD_OLLAMA_HOST=https://ollama.com
# CLOUD_OLLAMA_MODEL=deepseek-v3:cloud
# CLOUD_OLLAMA_API_KEY=

# ── Mode Toggle ──
# USE_CLOUD_LLM=false
# USE_OPENAI_FORMAT=false

# ── LLM Latency & Timeout Settings ──
# OLLAMA_TIMEOUT=300
# OLLAMA_MAX_TOKENS=512
# LLM_CACHE_TTL=1800
# LLM_MAX_AGE=120
# LLM_MAX_LATENCY=60000

# ── LLM Fusion & Gating Settings ──
# LLM_WEIGHT=0.20
# FINAL_SCORE_THRESHOLD=0.75

# ── Granular Logging Settings ──
# LOG_BINANCE_RESPONSES=false
# LOG_LLM=false

# Log all prompt payloads sent to Ollama and truncated JSON responses (true/false)
LOG_LLM=false

# ── Telegram Notification & Remote Control ──
# Get your token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get your ID from @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# =========================================================================
# Live Trading (engine_live) — CoinDCX execution
# =========================================================================
# Trading mode: paper | testnet | live
# - paper:   simulated fills (no venue, no creds needed)
# - testnet/live: real CoinDCX orders; requires credentials + passes self-test
MODE=paper

# Symbol to trade (Binance-style; mapped internally to CoinDCX B-<base>_USDT)
TRADE_SYMBOL=SOLUSDT

# Comma-separated watchlist for multi-symbol engine (e.g. multi_engine)
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT

# Starting equity for the wallet (paper) / sizing reference
INITIAL_BALANCE=1000

# Launch leverage cap. Hard-capped at 2x by config.validate().
MAX_LEVERAGE=2

# Market-data source: auto (Binance primary, CoinDCX fallback) | binance | coindcx
DATA_SOURCE=auto

# Feed freshness budget (ms). If no source is fresher than this, trading halts.
FEED_STALE_MS=15000

# CoinDCX API credentials (REQUIRED for testnet/live). Never commit real values.
COINDCX_API_KEY=
COINDCX_API_SECRET=
COINDCX_BASE_URL=https://api.coindcx.com
COINDCX_API_URL=https://api.coindcx.com

# Production event journal. Leave blank to use the local SQLite dev store.
# Example: postgresql://trader:trader@localhost:5432/crypto_trader
DATABASE_URL=

# Futures margin currency: USDT or INR (matches your funded futures wallet)
COINDCX_MARGIN_CURRENCY=USDT

# ── Venue-resident protective stops (F1) ──
# Place a resting STOP_MARKET on CoinDCX after entry so a crash can't leave a
# naked position. TP on the venue is off by default (software TP/scale-outs exist).
COINDCX_VENUE_SL_ENABLED=true
COINDCX_VENUE_TP_ENABLED=false
# If true, failing to place the venue SL trips HALT instead of degrading to software-only.
COINDCX_REQUIRE_VENUE_SL=false
# Software SL exit only fires this many bps past the SL when a venue SL exists (backup net).
SOFTWARE_SL_BACKUP_BPS=15

# ── TDS accounting (F2) ──
# 1% TDS on the sell leg for Indian residents. Defaults ON when margin currency is INR.
COINDCX_TDS_ENABLED=
COINDCX_TDS_RATE=0.01

# ── Cross-venue basis guard (F3) ──
# Reject entries when |(coindcx_mark - binance_mark)/binance_mark| exceeds the max,
# and nudge the entry trigger toward the fill venue by the buffer.
BASIS_GUARD_ENABLED=true
MAX_CROSS_VENUE_BASIS=0.005
ENTRY_BASIS_BUFFER=0.0005

# ── Paper execution-degradation model (F4) ──
# Per-side fill penalty (CoinDCX spread premium) and the market-order collar that
# rejects paper fills deviating more than this fraction from the reference price.
PAPER_CDCX_SPREAD_COEFF=0.0015
PAPER_COLLAR_PCT=0.10

# ── CoinDCX private/user stream (F5, optional) ──
# Real-time fill/position updates via socket.io; augments (never replaces) REST polling.
COINDCX_USER_STREAM_ENABLED=false
COINDCX_STREAM_URL=wss://stream.coindcx.com
COINDCX_STREAM_CHANNEL=coindcx

# ── Production-readiness guards (G1–G5) ──
# G1: warn (preflight) when local clock drifts more than this from CoinDCX (ms).
CLOCK_SKEW_MAX_MS=2000
# G2: per-minute order velocity circuit breaker, on top of the daily cap.
MAX_ORDERS_PER_MINUTE=6
# G3: HALT the engine if a WebSocket feed / position-manager thread dies silently.
THREAD_SUPERVISOR_ENABLED=true
# G5: on an unresolved venue desync, cancel ALL venue orders before halting.
RECONCILE_STRICT_CANCEL=false

# ── Redis Streams pipeline + Postgres projection (data modeling) ──
# Decouple strategy (producer) from execution (consumer group). EXECUTION_BUS=redis
# enables the run_consumer worker; inproc keeps the single-process default.
EXECUTION_BUS=inproc
REDIS_URL=redis://localhost:6379/0
SIGNAL_STREAM=execution:signals
CONSUMER_GROUP=execution_engine
# Poison-pill: route a signal to the DLQ after this many failed deliveries.
SIGNAL_MAX_DELIVERIES=3
# Idempotency window (s) so a replayed/duplicate signal isn't executed twice.
IDEMPOTENCY_TTL_SECONDS=300
# Materialize relational read-model tables (active_positions/orders/fills) in
# Postgres from the JSONB event stream, for UI/analytics. Requires DATABASE_URL.
PROJECTION_ENABLED=false

# ── Dashboard API + realtime UI (read-only) ──
# The bot publishes each event to a Redis pub/sub channel; the FastAPI dashboard
# relays it over SSE for realtime updates. Serve with:
#   uvicorn crypto_trader.api.app:app --host 0.0.0.0 --port 8000
API_HOST=0.0.0.0
API_PORT=8000
UI_EVENTS_ENABLED=true
UI_EVENTS_CHANNEL=events:ui
