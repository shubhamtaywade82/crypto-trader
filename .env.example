# =========================================================================
# Crypto Trader v4 — Configuration Template
# =========================================================================
# Copy this file to .env and adjust to your environment.
#
#   cp .env.example .env
#
# This file holds NON-SENSITIVE configuration only.
# For API keys, tokens, and live-trading gates see: .env.secrets.example
#
# Loading order (highest → lowest priority):
#   1. .env.secrets  — API keys, tokens, live-trading gates (gitignored)
#   2. .env          — this file; non-sensitive config
#   3. OS environment variables (override both files when set before launch)
# =========================================================================

# -------------------------------------------------------------------------
# 1. MODE & SAFETY GATES  (safe defaults — override in .env.secrets)
# -------------------------------------------------------------------------
# paper = simulated fills (mainnet market data, no orders sent)
# live  = real CoinDCX mainnet orders (requires credentials + passes self-test)
MODE=paper

# Live order placement/cancellation is sent to CoinDCX only when this is true.
# Set in .env.secrets, not here.
LIVE_TRADING_ENABLED=false

# Must equal exactly "I_UNDERSTAND_REAL_MONEY_WILL_BE_LOST" to allow live execution.
# Set in .env.secrets, not here.
LIVE_TRADING_ACK=

# Read-only live mode: PLACE_ORDER=false blocks ALL outbound order ops.
PLACE_ORDER=false

# -------------------------------------------------------------------------
# 2. COINDCX CONNECTION  (non-secret)
# -------------------------------------------------------------------------
# ⚠️  COINDCX_API_KEY and COINDCX_API_SECRET belong in .env.secrets

# API base URL (override only if CoinDCX changes its endpoint).
COINDCX_BASE_URL=https://api.coindcx.com

# Futures margin currency: USDT or INR (matches your funded futures wallet).
COINDCX_MARGIN_CURRENCY=USDT

# -------------------------------------------------------------------------
# 3. TRADING CONFIGURATION
# -------------------------------------------------------------------------
# Single-engine symbol (Binance-style; mapped internally to CoinDCX B-<base>_USDT).
TRADE_SYMBOL=SOLUSDT

# Comma-separated watchlist for the multi-symbol engine (multi_engine).
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT

# Starting equity for the wallet (paper) / sizing reference.
INITIAL_BALANCE=1000

# Launch leverage cap. Hard-capped at 2x by config.validate().
MAX_LEVERAGE=10

# Active leverage for position sizing and margin calculation.
LEVERAGE=10

# Market-data source: auto (Binance primary, CoinDCX fallback) | binance | coindcx
DATA_SOURCE=auto

# Feed freshness budget (ms). Entries/exits are vetoed when no source is fresher.
FEED_STALE_MS=15000

# -------------------------------------------------------------------------
# 4. RISK & PRODUCTION GUARDS (G1–G5)
# -------------------------------------------------------------------------
# Trading profile: conservative | moderate | aggressive
TRADING_PROFILE=aggressive

# Daily trade cap (G2).
MAX_DAILY_TRADES=2

# Per-minute order velocity circuit breaker, on top of the daily cap (G2).
MAX_ORDERS_PER_MINUTE=6

# Exchange margin-ratio liquidation guard: halt + flatten above this (G4).
MAX_MARGIN_RATIO=0.80

# Warn (preflight) when local clock drifts more than this from CoinDCX, ms (G1).
CLOCK_SKEW_MAX_MS=2000

# Halt the engine if a WebSocket feed / position-manager thread dies silently (G3).
THREAD_SUPERVISOR_ENABLED=true

# On an unresolved venue desync, cancel ALL venue orders before halting (G5).
RECONCILE_STRICT_CANCEL=false

# -------------------------------------------------------------------------
# 5. VENUE-RESIDENT PROTECTIVE STOPS (F1)
# -------------------------------------------------------------------------
COINDCX_VENUE_SL_ENABLED=true
COINDCX_VENUE_TP_ENABLED=false
COINDCX_REQUIRE_VENUE_SL=false
SOFTWARE_SL_BACKUP_BPS=15

# -------------------------------------------------------------------------
# 6. TDS ACCOUNTING (F2)
# -------------------------------------------------------------------------
# 1% TDS on the sell leg for Indian residents. Blank = defaults ON when margin is INR.
COINDCX_TDS_ENABLED=
COINDCX_TDS_RATE=0.01

# -------------------------------------------------------------------------
# 7. CROSS-VENUE BASIS GUARD (F3)
# -------------------------------------------------------------------------
BASIS_GUARD_ENABLED=true
MAX_CROSS_VENUE_BASIS=0.005
ENTRY_BASIS_BUFFER=0.0005

# -------------------------------------------------------------------------
# 8. PAPER EXECUTION-DEGRADATION MODEL (F4)
# -------------------------------------------------------------------------
PAPER_CDCX_SPREAD_COEFF=0.0015
PAPER_COLLAR_PCT=0.10

# -------------------------------------------------------------------------
# 9. COINDCX PRIVATE/USER STREAM (F5, optional)
# -------------------------------------------------------------------------
COINDCX_USER_STREAM_ENABLED=false
COINDCX_STREAM_URL=wss://stream.coindcx.com
COINDCX_STREAM_CHANNEL=coindcx

# -------------------------------------------------------------------------
# 10. PERSISTENCE & MESSAGING (Postgres + Redis)
# -------------------------------------------------------------------------
# Production event journal. Leave blank to use the local SQLite dev store.
# Override with real credentials in .env.secrets.
DATABASE_URL=

# Decouple strategy (producer) from execution (consumer group). EXECUTION_BUS=redis
# enables the run_consumer worker; inproc keeps the single-process default.
EXECUTION_BUS=inproc
REDIS_URL=redis://localhost:6382/0
SIGNAL_STREAM=execution:signals
CONSUMER_GROUP=execution_engine

# Poison-pill: route a signal to the DLQ after this many failed deliveries.
SIGNAL_MAX_DELIVERIES=3

# Idempotency window (s) so a replayed/duplicate signal isn't executed twice.
IDEMPOTENCY_TTL_SECONDS=300

# Materialize relational read-model tables in Postgres for UI/analytics.
PROJECTION_ENABLED=false

# -------------------------------------------------------------------------
# 11. DASHBOARD API + REALTIME UI (read-only)
# -------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
UI_EVENTS_ENABLED=true
UI_EVENTS_CHANNEL=events:ui

# -------------------------------------------------------------------------
# 12. TELEGRAM (token & chat ID belong in .env.secrets)
# -------------------------------------------------------------------------
# ⚠️  TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID belong in .env.secrets

# -------------------------------------------------------------------------
# 13. LLM ADVISORY LAYER (optional)
# -------------------------------------------------------------------------
# ── Local Ollama ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# ⚠️  OLLAMA_API_KEY belongs in .env.secrets

# ── Mode toggles ──
USE_LLM=true
# USE_CLOUD_LLM=false
# USE_OPENAI_FORMAT=false

# ── Latency & timeout ──
OLLAMA_TIMEOUT=300
OLLAMA_MAX_TOKENS=512
# LLM_CACHE_TTL=1800
# LLM_MAX_AGE=120
# LLM_MAX_LATENCY=60000

# ── Fusion & gating ──
# LLM_WEIGHT=0.20
# FINAL_SCORE_THRESHOLD=0.75

# -------------------------------------------------------------------------
# 14. LOGGING (optional)
# -------------------------------------------------------------------------
# LOG_BINANCE_RESPONSES=false
# LOG_LLM=false

# -------------------------------------------------------------------------
# 15. STRATEGY MODE
# -------------------------------------------------------------------------
# Controls which entry/exit engine is active. One of:
#   legacy          — original multi-playbook system (A, B, Ares, VolX, Sweep)
#   supertrend2     — Supertrend2 adaptive-ATR trend-following
#   mean_reversion  — SMA-band mean-reversion for ALL symbols in WATCHLIST
STRATEGY_MODE=legacy

# ── Mean Reversion settings (active only when STRATEGY_MODE=mean_reversion) ──
# MR_SMA_PERIOD=20
# MR_TIMEFRAME=15m
# MR_ENTRY_BAND=0.015
# MR_STOP_LOSS_PCT=0.008

# ── Supertrend2 settings (active only when STRATEGY_MODE=supertrend2) ──
# ST2_ATR_PERIOD=10
# ST2_FACTOR=3.0
# ST2_USE_ADAPTIVE_ATR=true
# ST2_TIMEFRAME=1h
# ST2_HTF_TIMEFRAME=4h
# ST2_ENTRY_MODE=flip
# ST2_RETRACEMENT_PCT=1.0
# ST2_FLIP_LOOKBACK=5
# ST2_USE_HTF_FILTER=true
# ST2_USE_VOL_FILTER=false
# ST2_VOL_MULTIPLIER=1.2
# ST2_USE_ADX_FILTER=false
# ST2_ADX_THRESHOLD=20
# ST2_TP1_PCT=1.0
# ST2_USE_TP=true
# ST2_SL_MODE=supertrend
# ST2_SL_PCT=1.5
# ST2_SL_ATR_MULT=2.5
# ST2_MAX_HOLD_HOURS=168
