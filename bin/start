#!/usr/bin/env bash
# One-command launcher: infrastructure + dashboard API + trading bot.
# Paper-safe by default (MODE defaults to paper). Forwards extra args to the
# bot, e.g.  ./bin/start --tick 60 --symbols BTCUSDT,ETHUSDT
set -e
cd "$(dirname "$0")/.."

# Load .env if present
if [ -f .env ]; then export $(grep -v '^#' .env | xargs); fi

# Defaults (overridable via .env / environment)
export DATABASE_URL=${DATABASE_URL:-"postgresql://trader:trader@localhost:5435/crypto_trader"}
export REDIS_URL=${REDIS_URL:-"redis://localhost:6382/0"}
export MODE=${MODE:-"paper"}
export PROJECTION_ENABLED=${PROJECTION_ENABLED:-"true"}
export MAX_MARGIN_RATIO=${MAX_MARGIN_RATIO:-"0.80"}

# Live mode with PLACE_ORDER=true is real money — require explicit confirmation.
# Read-only live mode (PLACE_ORDER=false) skips the prompt since no orders are sent.
place_order_val="${PLACE_ORDER:-false}"
if [ "$MODE" = "live" ] && [ "$place_order_val" = "true" ]; then
  echo "⚠️  MODE=live | PLACE_ORDER=true — REAL ORDERS WILL BE PLACED ON COINDCX."
  echo "    Ensure no HALT file is present."
  read -r -p "    Type 'live' to continue, anything else to abort: " confirm
  [ "$confirm" = "live" ] || { echo "Aborted."; exit 1; }
  # Automatically clear safety HALT file on explicit operator confirmation
  if [ -f "$HOME/.crypto_trader/HALT" ]; then
    echo "ℹ️  Clearing active HALT file on operator confirmation..."
    rm -f "$HOME/.crypto_trader/HALT"
  fi
  # Automatically clear latched risk state file on explicit operator confirmation
  if [ -f "$HOME/.crypto_trader/risk_state.json" ]; then
    echo "ℹ️  Clearing active risk state file on operator confirmation..."
    rm -f "$HOME/.crypto_trader/risk_state.json"
  fi
elif [ "$MODE" = "live" ]; then
  echo "ℹ️  MODE=live | PLACE_ORDER=false — read-only mode (no orders sent)."
  # Clear stale HALT / risk state from previous runs so read-only observation
  # isn't blocked by artifacts from an earlier failed live session.
  if [ -f "$HOME/.crypto_trader/HALT" ]; then
    echo "ℹ️  Clearing stale HALT file..."
    rm -f "$HOME/.crypto_trader/HALT"
  fi
  if [ -f "$HOME/.crypto_trader/risk_state.json" ]; then
    echo "ℹ️  Clearing stale risk state file..."
    rm -f "$HOME/.crypto_trader/risk_state.json"
  fi
fi

echo "--- Infrastructure (Postgres, Redis) ---"
docker compose up -d postgres redis
docker compose ps

# Pre-emptive cleanup of any orphaned processes to avoid port and lock conflicts
pkill -f "python3 -m crypto_trader.multi_engine" || true
pkill -f "python3 -m crypto_trader.api_service" || true

echo "--- Dashboard API (background) on :8088 ---"
rm -f api.log
python3 -m crypto_trader.api_service --port 8088 > api.log 2>&1 &
API_PID=$!

# Clean shutdown of all children on Ctrl+C / TERM
trap "echo ''; echo 'Shutting down...'; kill ${API_PID} ${BOT_PID} 2>/dev/null; exit" SIGINT SIGTERM

echo "--- Trading bot (multi-symbol, MODE=${MODE}) ---"
python3 -m crypto_trader.multi_engine "$@" &
BOT_PID=$!

echo ""
echo "===================================================="
echo "  Antigravity running | MODE=${MODE}"
echo "  API:  http://localhost:8088"
echo "  UI :  cd ui && npm run dev -- --port 3030   (-> http://localhost:3030)"
echo "  Logs: api.log     Stop: Ctrl+C"
echo "===================================================="
echo ""

# Keep the launcher alive so background processes keep running.
wait
