#!/usr/bin/env bash
# Development startup script for crypto-trader v4 (Backend Services)

set -e

# Ensure we run from the project root directory
cd "$(dirname "$0")/.."

# Load .env if it exists
if [ -f .env ]; then
  export $(grep -v '^#' .env | xargs)
fi

# Defaults if not in .env
export DATABASE_URL=${DATABASE_URL:-"postgresql://trader:trader@localhost:5435/crypto_trader"}
export REDIS_URL=${REDIS_URL:-"redis://localhost:6382/0"}
export MODE=${MODE:-"paper"}
export EXECUTION_BUS=${EXECUTION_BUS:-"redis"}
export PROJECTION_ENABLED=${PROJECTION_ENABLED:-"true"}
export MAX_MARGIN_RATIO=${MAX_MARGIN_RATIO:-"0.80"}

# 1. Start Infrastructure
echo "--- Starting Infrastructure (Postgres, Redis) ---"
docker compose up -d postgres redis
docker compose ps

# 2. Start Execution Consumer
echo "--- Starting Execution Consumer (Background) ---"
rm -f consumer.log
python3 -m crypto_trader.execution.run_consumer > consumer.log 2>&1 &
CONSUMER_PID=$!

# 3. Start Dashboard API
echo "--- Starting Dashboard API (Background) on port 8088 ---"
rm -f api.log
python3 -m crypto_trader.api_service --port 8088 > api.log 2>&1 &
API_PID=$!

# Cleanup on exit
trap "echo ''; echo 'Shutting down backend services...'; kill $CONSUMER_PID $API_PID 2>/dev/null; exit" SIGINT SIGTERM

echo ""
echo "===================================================="
echo "  CRYPTO TRADER v4 BACKEND READY"
echo "  API: http://localhost:8088"
echo "  (Logs: consumer.log, api.log)"
echo "===================================================="
echo ""
echo "To start the SolidJS Dashboard UI manually:"
echo "  cd ui"
echo "  npm run dev -- --port 3030"
echo ""
echo "Keeping backend services alive. Press Ctrl+C to stop."

# Keep script alive so background processes stay running
wait
