#!/usr/bin/env bash
# Run ONLY the trading bot (multi-symbol)

set -e
cd "$(dirname "$0")/.."

# Load .env
if [ -f .env ]; then export $(grep -v '^#' .env | xargs); fi

# Default infra ports
export DATABASE_URL=${DATABASE_URL:-"postgresql://trader:trader@localhost:5435/crypto_trader"}
export REDIS_URL=${REDIS_URL:-"redis://localhost:6382/0"}
export MAX_MARGIN_RATIO=${MAX_MARGIN_RATIO:-"0.80"}

echo "--- Ensuring Infrastructure is up ---"
docker compose up -d postgres redis

# Pre-emptive cleanup of any orphaned engine processes to avoid lock-file errors
pkill -f "python3 -m crypto_trader.multi_engine" || true

echo "--- Starting Trading Bot ---"
# Forward all arguments (e.g. ./bin/bot --tick 60)
exec python3 -m crypto_trader.multi_engine "$@"
