# =========================================================================
# Crypto Trader v4 — Secrets Template
# =========================================================================
# Copy this file to .env.secrets and fill in your real values.
#
#   cp .env.secrets.example .env.secrets
#
# IMPORTANT RULES:
#   • .env.secrets is GITIGNORED — never commit real secrets.
#   • Values in .env.secrets ALWAYS override .env (and OS env vars).
#   • Keep ALL API keys, tokens, and passwords here, NOT in .env.
#   • Uncomment only the lines you need; unused settings can stay commented.
#
# Loading order:
#   1. OS environment variables (highest priority when not overridden here)
#   2. .env.secrets  ← this file (always overrides .env)
#   3. .env          (non-sensitive config, loaded first)
# =========================================================================

# -------------------------------------------------------------------------
# 1. LIVE-TRADING SAFETY GATES
# -------------------------------------------------------------------------
# These three gates must ALL be set correctly before a single live order fires.
# Default in .env is paper/false — uncomment here to enable live trading.

# Trading mode: paper (safe default) | live (real money)
# MODE=live

# Set true to route order placement requests to CoinDCX.
# LIVE_TRADING_ENABLED=true

# Must equal this exact string (case-sensitive) to unlock live execution.
# LIVE_TRADING_ACK=I_UNDERSTAND_REAL_MONEY_WILL_BE_LOST

# Set false to block all order placement (read-only live feed).
# PLACE_ORDER=false

# -------------------------------------------------------------------------
# 2. COINDCX API CREDENTIALS  (REQUIRED for live trading)
# -------------------------------------------------------------------------
# Obtain from: CoinDCX dashboard → Settings → API Management
# Grant only the minimum permissions you need (e.g. Futures trading only).
COINDCX_API_KEY=your_coindcx_api_key_here
COINDCX_API_SECRET=your_coindcx_api_secret_here

# -------------------------------------------------------------------------
# 3. TELEGRAM NOTIFICATIONS & REMOTE CONTROL  (optional but recommended)
# -------------------------------------------------------------------------
# 1. Create a bot via @BotFather → save the token below.
# 2. Message your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# -------------------------------------------------------------------------
# 4. LLM API KEYS  (optional — only needed for cloud/keyed Ollama)
# -------------------------------------------------------------------------
# Leave blank for a local Ollama instance with no authentication.
OLLAMA_API_KEY=

# Cloud Ollama (uncomment if USE_CLOUD_LLM=true in .env)
# CLOUD_OLLAMA_API_KEY=your_cloud_ollama_key_here

# -------------------------------------------------------------------------
# 5. DATABASE & REDIS CREDENTIALS  (production overrides)
# -------------------------------------------------------------------------
# The .env file contains local dev defaults. Override them here for staging/prod.
# DATABASE_URL=postgresql://trader:your_db_password@localhost:5435/crypto_trader
# REDIS_URL=redis://:your_redis_password@localhost:6382/0

# -------------------------------------------------------------------------
# 6. MISC OVERRIDES  (any .env value can be overridden here)
# -------------------------------------------------------------------------
# Example: tighten risk limits for live without changing the shared .env
# MAX_LEVERAGE=2
# MAX_DAILY_TRADES=5
# COINDCX_MARGIN_CURRENCY=INR
